DELIMITER $$

DROP PROCEDURE IF EXISTS sp_CancelAppointment$$

CREATE PROCEDURE sp_CancelAppointment(
    IN p_appointment_id INT,
    IN p_cancel_reason VARCHAR(255),
    IN p_cancelled_by VARCHAR(50),
    OUT o_status_message VARCHAR(50)
)
BEGIN
    -- == 1. DECLARE VARIABLES ==
    DECLARE v_current_status VARCHAR(50);
    DECLARE v_doctor_schedule_id INT;
    DECLARE v_invoice_id INT;
    DECLARE v_paid_amount DECIMAL(10, 2);
    DECLARE v_now DATETIME;

    -- == 2. ERROR HANDLING ==
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET o_status_message = 'ERROR_SQL_EXCEPTION';
    END;

    SET v_now = NOW();
    START TRANSACTION;

    -- == 3. GET APPOINTMENT DATA (LOCK ROW) ==
    SELECT
        status,
        doctor_schedule_id,
        invoice_id
    INTO
        v_current_status,
        v_doctor_schedule_id,
        v_invoice_id
    FROM
        appointments
    WHERE
        id = p_appointment_id
    FOR UPDATE;

    -- == 4. VALIDATION ==
    IF v_current_status IS NULL THEN
        SET o_status_message = 'ERROR_NOT_FOUND';
        ROLLBACK;
    ELSEIF v_current_status = 'CANCELLED' THEN
        SET o_status_message = 'ERROR_ALREADY_CANCELLED';
        ROLLBACK;
    ELSEIF v_current_status = 'COMPLETED' THEN
        SET o_status_message = 'ERROR_CANNOT_CANCEL_COMPLETED';
        ROLLBACK;
    ELSE
        -- == 5. UPDATE APPOINTMENT STATUS ==
        UPDATE appointments
        SET
            status = 'CANCELLED',
            note = CONCAT(COALESCE(note, ''), ' [Cancelled: ', p_cancel_reason, ']'),
            updatedDate = v_now,
            updatedBy = p_cancelled_by
        WHERE id = p_appointment_id;

        -- == 6. UPDATE SCHEDULE COUNT (The "Active Count") ==
        -- We decrement this so a new patient can book this empty slot.
        UPDATE doctorSchedule
        SET registeredPatientCount = registeredPatientCount - 1
        WHERE id = v_doctor_schedule_id;

        -- == 7. LOGIC SPLIT: PAID vs UNPAID ==

        IF v_current_status = 'PENDING_PAYMENT' THEN
            -- == SCENARIO A: Patient hasn't paid yet ==
            -- Just mark invoice as Cancelled
            IF v_invoice_id IS NOT NULL THEN
                UPDATE invoices
                SET status = 'CANCELLED', updatedDate = v_now, updatedBy = p_cancelled_by
                WHERE id = v_invoice_id;
            END IF;

            SET o_status_message = 'CANCEL_SUCCESS';

        ELSEIF v_current_status = 'BOOKED' THEN
            -- == SCENARIO B: Patient Paid (REFUND NEEDED) ==

            -- 1. Mark Invoice as REFUNDED (or Cancelled)
            -- First, get the amount they paid
            SELECT finalAmount INTO v_paid_amount
            FROM invoices WHERE id = v_invoice_id;

            UPDATE invoices
            SET status = 'CANCELLED', updatedDate = v_now, updatedBy = p_cancelled_by
            WHERE id = v_invoice_id;

            -- 2. RECORD THE REFUND (Negative Payment)
            -- This balances your financial reports automatically
            INSERT INTO payments (
                invoice_id,
                amountPaid,
                paymentMethod,
                paymentStatus,
                transactionId,
                createdDate,
                createdBy
            ) VALUES (
                v_invoice_id,
                v_paid_amount * -1, -- NEGATIVE AMOUNT (e.g., -5000)
                'CASH',             -- Assuming refund is cash (or pass as param)
                'REFUNDED',
                CONCAT('REF-', p_appointment_id),
                v_now,
                p_cancelled_by
            );

            SET o_status_message = 'REFUND_SUCCESS';

        END IF;

        COMMIT;
    END IF;
END$$

DELIMITER ;