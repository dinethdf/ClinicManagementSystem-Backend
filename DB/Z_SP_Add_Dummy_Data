    -- Doctor 16
    INSERT IGNORE INTO doctor (id, clinic_id, firstName, lastName, nameWithInitials, gender, dob, nic, email, mobileNo, address, city, district, slmcNumber, specialization_id, qualification, experienceYears, availability_status, isApproved, createdDate, createdBy)
    VALUES (16, 1, 'Arun', 'Prakash', 'A. Prakash', 1, '1981-09-07', '812511234V', 'arun.prakash@clinic.com', '0777890123', '33 Sea Street', 'Trincomalee', 'Trincomalee', 'DOC016', 3, 'MBBS, MD (Cardiology)', 16, 'AVAILABLE', 1, NOW(), 'seed');


    -- 2. Ensure Patients 50 to 70 exist (Full Details Loop)
    -- This covers the range of 50 + FLOOR(RAND() * 20)
    SET @p_id = 50;

    WHILE @p_id <= 70 DO
        INSERT IGNORE INTO patient (
            id, clinic_id, patientNo, firstName, lastName, fullName,
