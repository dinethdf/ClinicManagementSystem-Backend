-- ==============================================================================
-- STEP 2: GENERATE 2025 TRANSACTION DATA (For BOTH Clinics)
-- ==============================================================================
CREATE PROCEDURE GenerateData2025()
BEGIN
    DECLARE m INT DEFAULT 1;
    DECLARE i INT DEFAULT 1;
    DECLARE c INT DEFAULT 1; -- Clinic Iterator

    DECLARE v_clinic_id INT;
    DECLARE v_doc_id INT;
    DECLARE v_pat_id INT;
    DECLARE v_sched_date DATE;
    DECLARE v_created_datetime DATETIME;
    DECLARE v_sched_id INT;
    DECLARE v_inv_id INT;
    DECLARE v_amount DECIMAL(10,2);

    -- Loop Jan to Dec
    WHILE m <= 12 DO
        SET i = 1;
        -- Loop 4 times per month
        WHILE i <= 4 DO

            -- NEW: Loop through Clinics (1 and 2)
            SET c = 1;
            WHILE c <= 2 DO
                SET v_clinic_id = c;

                -- -----------------------------------------------------
                -- LOGIC SELECTOR BASED ON CLINIC ID
                -- -----------------------------------------------------
                IF v_clinic_id = 1 THEN
                    -- CLINIC 1 LOGIC
                    -- Rotate Doctors (4, 10, 16)
                    IF (m + i) % 3 = 0 THEN SET v_doc_id = 4;
                    ELSEIF (m + i) % 3 = 1 THEN SET v_doc_id = 10;
                    ELSE SET v_doc_id = 16;
                    END IF;

                    -- Random Patient (50-69)
                    SET v_pat_id = 50 + FLOOR(RAND() * 20);

                ELSE
                    -- CLINIC 2 LOGIC
                    -- Rotate Doctors (24, 30, 36)
                    IF (m + i) % 3 = 0 THEN SET v_doc_id = 24;
                    ELSEIF (m + i) % 3 = 1 THEN SET v_doc_id = 30;
                    ELSE SET v_doc_id = 36;
                    END IF;

                    -- Random Patient (150-169)
                    SET v_pat_id = 150 + FLOOR(RAND() * 20);
                END IF;
                -- -----------------------------------------------------

                -- Date & Time Generation
                SET v_sched_date = DATE(CONCAT('2025-', m, '-', (i * 5) + 1));
                SET v_created_datetime = CONCAT(v_sched_date, ' 08:00:00');
                SET v_amount = 1500 + FLOOR(RAND() * 3000);

                -- A. Insert Schedule
                INSERT INTO doctorSchedule (clinic_id, doctor_id, scheduleDate, startTime, endTime, doctorFee, clinicFee, maxPatientCount, isActive, isApproved, createdDate, createdBy)
                VALUES (v_clinic_id, v_doc_id, v_sched_date, '09:00:00', '13:00:00', v_amount - 500, 500, 15, 1, 1, v_created_datetime, 'AutoGen');
                SET v_sched_id = LAST_INSERT_ID();

                -- B. Insert Invoice
                INSERT INTO invoices (clinic_id, patient_id, status, subtotalAmount, totalDiscount, finalAmount, isApproved, createdDate, createdBy)
                VALUES (v_clinic_id, v_pat_id, 'PAID', v_amount, 0, v_amount, 1, v_created_datetime, 'AutoGen');
                SET v_inv_id = LAST_INSERT_ID();

                -- C. Insert Invoice Item
                INSERT INTO invoice_items (clinic_id, invoice_id, item_type_id, description, amount, isApproved, createdDate, createdBy)
                VALUES (v_clinic_id, v_inv_id, 1, CONCAT('Consultation Fee - Dr ', v_doc_id), v_amount, 1, v_created_datetime, 'AutoGen');

                -- D. Insert Payment
                INSERT INTO payments (clinic_id, invoice_id, amountPaid, paymentMethod, paymentStatus, isApproved, createdDate, createdBy)
                VALUES (v_clinic_id, v_inv_id, v_amount, 'CASH', 'COMPLETED', 1, v_created_datetime, 'AutoGen');

                -- E. Insert Appointment
                INSERT INTO appointments (clinic_id, queuePosition, status, doctor_schedule_id, patient_id, invoice_id, isApproved, createdDate, createdBy)
                VALUES (v_clinic_id, 1, 'COMPLETED', v_sched_id, v_pat_id, v_inv_id, 1, v_created_datetime, 'AutoGen');

                SET c = c + 1;
            END WHILE; -- End Clinic Loop

            SET i = i + 1;
        END WHILE; -- End Week Loop

        COMMIT;
        SET m = m + 1;
    END WHILE; -- End Month Loop
END $$

DELIMITER ;

-- ==============================================================================
-- EXECUTION
-- ==============================================================================
CALL PrepareSeedData();
CALL GenerateData2025();

-- CLEANUP
DROP PROCEDURE IF EXISTS PrepareSeedData;
