DELIMITER $$

DROP PROCEDURE IF EXISTS GetScheduleFinancials $$

CREATE PROCEDURE GetScheduleFinancials(
    IN p_clinic_id INT,
    IN input_schedule_id INT
)
BEGIN
    SELECT
        -- 1. Appointment & Patient Details
        appt.id AS AppointmentID,
        appt.queuePosition AS QueueNo,
        CONCAT(p.firstName, ' ', p.lastName) AS PatientName,
        p.mobileNo AS PatientMobile,
        inv.id AS InvoiceID,
        inv.status AS PaymentStatus,

        -- 2. Base Fees (From the Schedule)
        ds.doctorFee AS BaseDoctorFee,
        ds.clinicFee AS BaseClinicFee,

        -- 3. Doctor Side Calculations
        -- Sum up doctor discounts. Assumes amount is stored as NEGATIVE for discounts.
        COALESCE(SUM(CASE
            WHEN it.typeName = 'DOCTOR_DISCOUNT' THEN ii.amount
            ELSE 0
        END), 0) AS DoctorDiscountAmount,

        -- Net Payout: Fee + (Negative Discount) = Final Amount
        (ds.doctorFee + COALESCE(SUM(CASE
            WHEN it.typeName = 'DOCTOR_DISCOUNT' THEN ii.amount
            ELSE 0
        END), 0)) AS NetDoctorPayout,

        -- 4. Clinic Side Calculations
        COALESCE(SUM(CASE
            WHEN it.typeName = 'CLINIC_DISCOUNT' THEN ii.amount
            ELSE 0
        END), 0) AS ClinicDiscountAmount,

        (ds.clinicFee + COALESCE(SUM(CASE
            WHEN it.typeName = 'CLINIC_DISCOUNT' THEN ii.amount
            ELSE 0
        END), 0)) AS NetClinicProfit,

        -- 5. Total Paid
        inv.finalAmount AS TotalPaidByPatient

    FROM appointments appt

    -- Join Schedule (Tenant Secured)
    JOIN doctorSchedule ds ON appt.doctor_schedule_id = ds.id
        AND ds.clinic_id = p_clinic_id

    -- Join Patient (Tenant Secured)
    JOIN patient p ON appt.patient_id = p.id
        AND p.clinic_id = p_clinic_id

    -- Join Invoice (Tenant Secured)
    LEFT JOIN invoices inv ON appt.invoice_id = inv.id
        AND inv.clinic_id = p_clinic_id

    -- Join Invoice Items (Tenant Secured)
    LEFT JOIN invoice_items ii ON inv.id = ii.invoice_id
        AND ii.clinic_id = p_clinic_id

    -- Join Item Types (Assuming Global or Shared Lookup)
    LEFT JOIN item_types it ON ii.item_type_id = it.id

    WHERE
        appt.doctor_schedule_id = input_schedule_id
        AND appt.clinic_id = p_clinic_id
        AND appt.status != 'CANCELLED'

    GROUP BY
        appt.id, p.id, inv.id, ds.doctorFee, ds.clinicFee

    ORDER BY
        appt.queuePosition ASC;

END $$

DELIMITER ;