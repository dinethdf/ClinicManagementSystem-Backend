-- 2. PAYMENT PLAN STATUS VIEW (Updated for Lookups)
-- ==================================================================================
DROP VIEW IF EXISTS v_payment_plan_status;

CREATE VIEW v_payment_plan_status AS
SELECT
    pp.id AS plan_id,
    pp.clinic_id,
    pp.invoice_id,
    i.patient_id,
    CONCAT(p.firstName, ' ', p.lastName) AS patient_name,

    pp.totalInstallments,
    pp.paidInstallments,
    (pp.totalInstallments - pp.paidInstallments) AS remaining_installments,

    pp.installmentAmount,
    (pp.installmentAmount * pp.totalInstallments) AS total_plan_amount,
    (pp.installmentAmount * pp.paidInstallments) AS total_paid_amount,
    (pp.installmentAmount * (pp.totalInstallments - pp.paidInstallments)) AS remaining_amount,

    freq.displayName AS frequency,   -- From Lookup
    pp.nextDueDate,
    stat.displayName AS planStatus,  -- From Lookup

    CASE
        WHEN pp.nextDueDate < CURDATE() AND stat.code = 'ACTIVE' THEN 'OVERDUE'
        WHEN stat.code = 'ACTIVE' THEN 'CURRENT'
        ELSE stat.displayName
    END AS current_status,

    DATEDIFF(CURDATE(), pp.nextDueDate) AS days_overdue,

    i.finalAmount AS invoice_total,
    i.amountPaid AS invoice_paid,
    i.balanceRemaining AS invoice_balance

FROM payment_plans pp
INNER JOIN invoices i ON pp.invoice_id = i.id
INNER JOIN patient p ON i.patient_id = p.id
LEFT JOIN payment_plan_status_lookup stat ON pp.planStatusId = stat.id
LEFT JOIN payment_frequency_lookup freq ON pp.frequencyId = freq.id;

