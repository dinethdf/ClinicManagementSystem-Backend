-- Check and add columns for payments table
SET @col_exists = (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'clinicmsystem' AND TABLE_NAME = 'payments' AND COLUMN_NAME = 'receivedBy');
SET @sql = IF(@col_exists = 0,
    'ALTER TABLE payments ADD COLUMN receivedBy VARCHAR(50) NULL COMMENT ''Staff/Cashier who physically received payment'' AFTER createdBy',
    'SELECT ''Column receivedBy already exists''');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

SET @col_exists = (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'clinicmsystem' AND TABLE_NAME = 'payments' AND COLUMN_NAME = 'paymentLocation');
SET @sql = IF(@col_exists = 0,
    'ALTER TABLE payments ADD COLUMN paymentLocation ENUM(''CLINIC_COUNTER'', ''ONLINE'', ''MOBILE_APP'', ''BANK'', ''INSURANCE_DIRECT'') NULL DEFAULT ''CLINIC_COUNTER'' AFTER paymentMethod',
    'SELECT ''Column paymentLocation already exists''');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

SET @col_exists = (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'clinicmsystem' AND TABLE_NAME = 'payments' AND COLUMN_NAME = 'paymentGateway');
SET @sql = IF(@col_exists = 0,
    'ALTER TABLE payments ADD COLUMN paymentGateway VARCHAR(50) NULL COMMENT ''Payment gateway: Stripe, PayPal, PayHere'' AFTER paymentLocation',
    'SELECT ''Column paymentGateway already exists''');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

SET @col_exists = (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'clinicmsystem' AND TABLE_NAME = 'payments' AND COLUMN_NAME = 'gatewayResponse');
SET @sql = IF(@col_exists = 0,
    'ALTER TABLE payments ADD COLUMN gatewayResponse JSON NULL COMMENT ''Raw payment gateway response'' AFTER transactionId',
    'SELECT ''Column gatewayResponse already exists''');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

SET @col_exists = (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'clinicmsystem' AND TABLE_NAME = 'payments' AND COLUMN_NAME = 'expiresAt');
SET @sql = IF(@col_exists = 0,
    'ALTER TABLE payments ADD COLUMN expiresAt DATETIME NULL COMMENT ''Expiry time for pending online payments'' AFTER paymentTimestamp',
    'SELECT ''Column expiresAt already exists''');
PREPARE stmt FROM @sql; EXECUTE stmt; DEALLOCATE PREPARE stmt;

SET @col_exists = (SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'clinicmsystem' AND TABLE_NAME = 'payments' AND COLUMN_NAME = 'cashierWorkstationId');
SET @sql = IF(@col_exists = 0,
