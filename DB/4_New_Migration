-- ==================================================================================
-- PART G: INITIALIZE INVOICE BALANCES (For existing data)
-- ==================================================================================

-- Recalculate amountPaid and balanceRemaining for existing invoices
UPDATE invoices i
SET
    amountPaid = COALESCE((
        SELECT SUM(p.amountPaid)
        FROM payments p
        WHERE p.invoice_id = i.id
        AND p.paymentStatus = 'COMPLETED'
    ), 0),
    balanceRemaining = i.finalAmount - COALESCE((
        SELECT SUM(p.amountPaid)
        FROM payments p
        WHERE p.invoice_id = i.id
        AND p.paymentStatus = 'COMPLETED'
    ), 0),
    updatedDate = NOW(),
    updatedBy = 'MIGRATION_SCRIPT'
WHERE i.id > 0 AND i.amountPaid = 0;

-- Update invoice status based on payment balance
UPDATE invoices
SET
    status = CASE
        WHEN balanceRemaining <= 0 AND finalAmount > 0 THEN 'PAID'
        WHEN amountPaid > 0 AND balanceRemaining > 0 THEN 'PARTIAL'
        WHEN amountPaid = 0 THEN 'UNPAID'
        ELSE status
    END,
    updatedDate = NOW(),
    updatedBy = 'MIGRATION_SCRIPT'
WHERE id > 0;

