-- -----------------------------------------------
-- D.1 Payment Plans Table
-- -----------------------------------------------
CREATE TABLE IF NOT EXISTS payment_plans (
    id INT AUTO_INCREMENT PRIMARY KEY,
    clinic_id INT NOT NULL,
    invoice_id INT NOT NULL,

    totalInstallments INT NOT NULL COMMENT 'Total number of payments',
    installmentAmount DECIMAL(10,2) NOT NULL COMMENT 'Amount per installment',
    frequency ENUM('WEEKLY', 'BIWEEKLY', 'MONTHLY', 'CUSTOM') NOT NULL DEFAULT 'MONTHLY',

    paidInstallments INT NOT NULL DEFAULT 0 COMMENT 'Payments received so far',
    nextDueDate DATE NOT NULL COMMENT 'When next installment is due',
    planStatus ENUM('ACTIVE', 'COMPLETED', 'DEFAULTED', 'CANCELLED') NOT NULL DEFAULT 'ACTIVE',

    notes TEXT NULL,

    createdDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    createdBy VARCHAR(50) NOT NULL,
    updatedDate DATETIME DEFAULT NULL,
    updatedBy VARCHAR(50) DEFAULT NULL,
    approvedDate DATETIME DEFAULT NULL,
    approvedBy VARCHAR(50) DEFAULT NULL,

    CONSTRAINT fk_plan_clinic FOREIGN KEY (clinic_id) REFERENCES clinics(id) ON DELETE RESTRICT,
    CONSTRAINT fk_plan_invoice FOREIGN KEY (invoice_id) REFERENCES invoices(id) ON DELETE CASCADE,

    UNIQUE INDEX idx_one_plan_per_invoice (clinic_id, invoice_id),
    INDEX idx_active_plans (clinic_id, planStatus, nextDueDate)
) ENGINE=InnoDB;

-- -----------------------------------------------
-- D.2 Payment Reminders Table
-- -----------------------------------------------
CREATE TABLE IF NOT EXISTS payment_reminders (
    id INT AUTO_INCREMENT PRIMARY KEY,
    clinic_id INT NOT NULL,
    invoice_id INT NOT NULL,
    patient_id INT NOT NULL,

    reminderType ENUM('SMS', 'EMAIL', 'WHATSAPP', 'CALL', 'PUSH_NOTIFICATION') NOT NULL,
    reminderStatus ENUM('PENDING', 'SENT', 'FAILED', 'DELIVERED', 'CANCELLED') NOT NULL DEFAULT 'PENDING',
    scheduledDate DATETIME NOT NULL,
    sentDate DATETIME NULL,

    messageContent TEXT NULL,
    responseReceived TEXT NULL,
    externalMessageId VARCHAR(255) NULL,

    createdDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    createdBy VARCHAR(50) NOT NULL,
    updatedDate DATETIME DEFAULT NULL,
    updatedBy VARCHAR(50) DEFAULT NULL,

    CONSTRAINT fk_reminder_clinic FOREIGN KEY (clinic_id) REFERENCES clinics(id) ON DELETE RESTRICT,
    CONSTRAINT fk_reminder_invoice FOREIGN KEY (invoice_id) REFERENCES invoices(id) ON DELETE CASCADE,
    CONSTRAINT fk_reminder_patient FOREIGN KEY (patient_id) REFERENCES patient(id) ON DELETE CASCADE,

    INDEX idx_pending_reminders (clinic_id, reminderStatus, scheduledDate),
    INDEX idx_patient_reminders (clinic_id, patient_id, reminderStatus)
) ENGINE=InnoDB;

-- -----------------------------------------------
-- D.3 Payment Gateway Configuration Table
-- -----------------------------------------------
CREATE TABLE IF NOT EXISTS payment_gateway_config (
    id INT AUTO_INCREMENT PRIMARY KEY,
    clinic_id INT NOT NULL,

    gatewayName VARCHAR(50) NOT NULL,
    displayName VARCHAR(100) NULL,
    isActive TINYINT NOT NULL DEFAULT 0,
    isTestMode TINYINT NOT NULL DEFAULT 1,

    apiKey VARCHAR(500) NULL,
    apiSecret VARCHAR(500) NULL,
    merchantId VARCHAR(255) NULL,
    webhookSecret VARCHAR(500) NULL,

    webhookUrl VARCHAR(500) NULL,
    successRedirectUrl VARCHAR(500) NULL,
    failureRedirectUrl VARCHAR(500) NULL,
    cancelRedirectUrl VARCHAR(500) NULL,

    minTransactionAmount DECIMAL(10,2) DEFAULT 100.00,
    maxTransactionAmount DECIMAL(10,2) DEFAULT 100000.00,
    transactionFeePercentage DECIMAL(5,2) DEFAULT 0.00,
    transactionFeeFixed DECIMAL(10,2) DEFAULT 0.00,

    supportsRefunds TINYINT DEFAULT 1,
    supportsPartialRefunds TINYINT DEFAULT 1,
    supportsRecurring TINYINT DEFAULT 0,

    createdDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    createdBy VARCHAR(50) NOT NULL,
    updatedDate DATETIME DEFAULT NULL,
    updatedBy VARCHAR(50) DEFAULT NULL,

    CONSTRAINT fk_gateway_clinic FOREIGN KEY (clinic_id) REFERENCES clinics(id) ON DELETE RESTRICT,

    UNIQUE INDEX idx_gateway_per_clinic (clinic_id, gatewayName),
    INDEX idx_active_gateways (clinic_id, isActive)
) ENGINE=InnoDB;

-- -----------------------------------------------
-- D.4 Payment Audit Log Table
-- -----------------------------------------------
CREATE TABLE IF NOT EXISTS payment_audit_log (
    id INT AUTO_INCREMENT PRIMARY KEY,
    clinic_id INT NOT NULL,
    payment_id INT NOT NULL,
    invoice_id INT NOT NULL,

    actionType ENUM('CREATED', 'STATUS_CHANGED', 'AMOUNT_ADJUSTED', 'REFUNDED', 'CANCELLED', 'EXPIRED') NOT NULL,
    oldStatus VARCHAR(50) NULL,
    newStatus VARCHAR(50) NULL,
    oldAmount DECIMAL(10,2) NULL,
    newAmount DECIMAL(10,2) NULL,

    reason TEXT NULL,
    additionalData JSON NULL,

    actionDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actionBy VARCHAR(50) NOT NULL,

    ipAddress VARCHAR(50) NULL,
    userAgent VARCHAR(255) NULL,

    CONSTRAINT fk_audit_clinic FOREIGN KEY (clinic_id) REFERENCES clinics(id) ON DELETE RESTRICT,
    CONSTRAINT fk_audit_payment FOREIGN KEY (payment_id) REFERENCES payments(id) ON DELETE CASCADE,
    CONSTRAINT fk_audit_invoice FOREIGN KEY (invoice_id) REFERENCES invoices(id) ON DELETE CASCADE,

    INDEX idx_audit_lookup (clinic_id, payment_id),
    INDEX idx_audit_timeline (clinic_id, actionDate),
    INDEX idx_audit_action (clinic_id, actionType, actionDate)
) ENGINE=InnoDB;

-- -----------------------------------------------
-- D.5 Online Payment Transactions Table
-- -----------------------------------------------
CREATE TABLE IF NOT EXISTS online_payment_transactions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    clinic_id INT NOT NULL,
    payment_id INT NOT NULL,
    invoice_id INT NOT NULL,

    gatewayName VARCHAR(50) NOT NULL,
    gatewayTransactionId VARCHAR(255) NULL,
    gatewayOrderId VARCHAR(255) NULL,

    requestPayload JSON NULL,
    responsePayload JSON NULL,
    webhookPayload JSON NULL,

    transactionStatus ENUM('INITIATED', 'REDIRECTED', 'PROCESSING', 'SUCCESS', 'FAILED', 'TIMEOUT') NOT NULL DEFAULT 'INITIATED',
    errorCode VARCHAR(100) NULL,
    errorMessage TEXT NULL,

    initiatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completedAt DATETIME NULL,
    webhookReceivedAt DATETIME NULL,

    checksumSent VARCHAR(255) NULL,
    checksumReceived VARCHAR(255) NULL,
    isVerified TINYINT DEFAULT 0,

    CONSTRAINT fk_online_tx_clinic FOREIGN KEY (clinic_id) REFERENCES clinics(id) ON DELETE RESTRICT,
    CONSTRAINT fk_online_tx_payment FOREIGN KEY (payment_id) REFERENCES payments(id) ON DELETE CASCADE,
    CONSTRAINT fk_online_tx_invoice FOREIGN KEY (invoice_id) REFERENCES invoices(id) ON DELETE CASCADE,

    UNIQUE INDEX idx_gateway_transaction (gatewayName, gatewayTransactionId),
    INDEX idx_transaction_status (clinic_id, transactionStatus),
    INDEX idx_payment_lookup (payment_id)
) ENGINE=InnoDB;

