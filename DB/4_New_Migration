-- 3. CASHIER DAILY SUMMARY VIEW (Updated for Lookups)
-- ==================================================================================
DROP VIEW IF EXISTS v_cashier_daily_summary;

CREATE VIEW v_cashier_daily_summary AS
SELECT
    p.clinic_id,
    p.receivedBy AS cashier_id,
    DATE(p.paymentTimestamp) AS payment_date,

    COUNT(p.id) AS total_transactions,

    -- Status Counts using Lookup Codes
    SUM(CASE WHEN s.code = 'COMPLETED' THEN 1 ELSE 0 END) AS successful_transactions,
    SUM(CASE WHEN s.code = 'FAILED' THEN 1 ELSE 0 END) AS failed_transactions,
    SUM(CASE WHEN s.code = 'REFUNDED' THEN 1 ELSE 0 END) AS refunded_transactions,

    -- Totals by Method using Lookup Codes
    SUM(CASE WHEN s.code = 'COMPLETED' AND m.code = 'CASH' THEN p.amountPaid ELSE 0 END) AS total_cash,
    SUM(CASE WHEN s.code = 'COMPLETED' AND m.code = 'CARD' THEN p.amountPaid ELSE 0 END) AS total_card,
    SUM(CASE WHEN s.code = 'COMPLETED' AND m.code = 'BANK_TRANSFER' THEN p.amountPaid ELSE 0 END) AS total_bank,
    SUM(CASE WHEN s.code = 'COMPLETED' AND m.code = 'ONLINE' THEN p.amountPaid ELSE 0 END) AS total_online,

    SUM(CASE WHEN s.code = 'COMPLETED' THEN p.amountPaid ELSE 0 END) AS total_collected,
    SUM(CASE WHEN s.code = 'REFUNDED' THEN ABS(p.amountPaid) ELSE 0 END) AS total_refunded,

    MIN(p.paymentTimestamp) AS first_transaction_time,
    MAX(p.paymentTimestamp) AS last_transaction_time

FROM payments p
LEFT JOIN payment_status_lookup s ON p.paymentStatusId = s.id
LEFT JOIN payment_method_lookup m ON p.paymentMethodId = m.id
WHERE p.receivedBy IS NOT NULL
GROUP BY p.clinic_id, p.receivedBy, DATE(p.paymentTimestamp);

