-- ==================================================================================
-- 1. INVOICE SUMMARY VIEW (Fixed Calculation Logic)
-- ==================================================================================
DROP VIEW IF EXISTS v_invoice_summary;

CREATE VIEW v_invoice_summary AS
SELECT
    i.id AS invoice_id,
    i.clinic_id,
    i.patient_id,
    COALESCE(s.code, 'UNKNOWN') AS invoice_status, -- From Lookup
    i.createdDate AS invoice_date,

    -- Stored values (Fastest)
    i.subtotalAmount AS stored_subtotal,
    i.totalDiscount AS stored_discount,
    i.finalAmount AS stored_final,
    i.amountPaid AS stored_paid,
    i.balanceRemaining AS stored_balance,

    -- Calculated from Items (Fixed: Pre-aggregated to avoid duplication)
    COALESCE(item_stats.calc_subtotal, 0) AS calculated_subtotal,
    COALESCE(item_stats.calc_discount, 0) AS calculated_discount,
    COALESCE(item_stats.calc_total, 0) AS calculated_final,

    -- Calculated from Payments (Fixed: Pre-aggregated)
    COALESCE(pay_stats.calc_paid, 0) AS calculated_paid,
    (COALESCE(item_stats.calc_total, 0) - COALESCE(pay_stats.calc_paid, 0)) AS calculated_balance,

    -- Integrity Check
    CASE
        WHEN ABS(COALESCE(item_stats.calc_total, 0) - i.finalAmount) > 0.01 THEN 'AMOUNT_MISMATCH'
        WHEN ABS(
            (COALESCE(item_stats.calc_total, 0) - COALESCE(pay_stats.calc_paid, 0))
            - i.balanceRemaining
        ) > 0.01 THEN 'BALANCE_MISMATCH'
        ELSE 'OK'
    END AS data_integrity_status,

    COALESCE(pay_stats.total_tx, 0) AS total_payments,
    COALESCE(pay_stats.success_tx, 0) AS successful_payments,
    COALESCE(pay_stats.pending_tx, 0) AS pending_payments,

    i.paymentDueDate,
    i.nextPaymentDue

FROM invoices i
LEFT JOIN invoice_status_lookup s ON i.statusId = s.id

-- Subquery 1: Aggregate Items per Invoice first
LEFT JOIN (
    SELECT
        invoice_id,
        SUM(CASE WHEN amount > 0 THEN amount ELSE 0 END) as calc_subtotal,
        SUM(CASE WHEN amount < 0 THEN ABS(amount) ELSE 0 END) as calc_discount,
        SUM(amount) as calc_total
    FROM invoice_items
    GROUP BY invoice_id
) item_stats ON i.id = item_stats.invoice_id

-- Subquery 2: Aggregate Payments per Invoice first
LEFT JOIN (
    SELECT
        invoice_id,
        -- Hardcoded ID check is risky, joining to lookup inside subquery is safer but slower.
        -- Assuming standard IDs or logic here. Better to join lookup in outer query or check Code.
        SUM(CASE WHEN p.paymentStatusId = (SELECT id FROM payment_status_lookup WHERE code='COMPLETED' LIMIT 1) THEN p.amountPaid ELSE 0 END) as calc_paid,
        COUNT(p.id) as total_tx,
        COUNT(CASE WHEN p.paymentStatusId = (SELECT id FROM payment_status_lookup WHERE code='COMPLETED' LIMIT 1) THEN 1 END) as success_tx,
        COUNT(CASE WHEN p.paymentStatusId = (SELECT id FROM payment_status_lookup WHERE code='PENDING' LIMIT 1) THEN 1 END) as pending_tx
    FROM payments p
    GROUP BY invoice_id
) pay_stats ON i.id = pay_stats.invoice_id;

