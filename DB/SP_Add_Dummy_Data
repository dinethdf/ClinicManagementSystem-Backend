DELIMITER $$

-- 1. DROP existing procedure to avoid conflicts
DROP PROCEDURE IF EXISTS GenerateData2025 $$

-- 2. CREATE the procedure with DYNAMIC DATES
CREATE PROCEDURE GenerateData2025()
BEGIN
    DECLARE m INT DEFAULT 1; -- Month Counter (1 to 12)
    DECLARE i INT DEFAULT 1; -- Record Counter (1 to 4 per month)

    DECLARE v_doc_id INT;
    DECLARE v_pat_id INT;
    DECLARE v_sched_date DATE;
    DECLARE v_created_datetime DATETIME; -- <--- NEW VARIABLE FOR CORRECT TIMESTAMPS
    DECLARE v_sched_id INT;
    DECLARE v_inv_id INT;
    DECLARE v_amount DECIMAL(10,2);

    -- Loop Jan to Dec
    WHILE m <= 12 DO
        SET i = 1;

        -- Loop 4 times per month
        WHILE i <= 4 DO

            -- DATA LOGIC: Rotate Doctors (4, 10, 16)
            IF (m + i) % 3 = 0 THEN SET v_doc_id = 4;
            ELSEIF (m + i) % 3 = 1 THEN SET v_doc_id = 10;
            ELSE SET v_doc_id = 16;
            END IF;

            -- DATA LOGIC: Random Patient (50-69)
            SET v_pat_id = 50 + FLOOR(RAND() * 20);

            -- DATA LOGIC: Date (Every 5 days)
            SET v_sched_date = DATE(CONCAT('2025-', m, '-', (i * 5) + 1));

            -- DATA LOGIC: Create Date matches Schedule Date (at 8:00 AM)
            -- This ensures your reports see the data in the correct month
            SET v_created_datetime = CONCAT(v_sched_date, ' 08:00:00');

            -- DATA LOGIC: Random Amount (1500 - 4500)
            SET v_amount = 1500 + FLOOR(RAND() * 3000);

            -- A. Insert Schedule (Using v_created_datetime instead of NOW())
            INSERT INTO doctorSchedule
            (doctor_id, scheduleDate, startTime, endTime, doctorFee, clinicFee, maxPatientCount, isActive, isApproved, createdDate, createdBy)
            VALUES
            (v_doc_id, v_sched_date, '09:00:00', '13:00:00', v_amount - 500, 500, 15, 1, 1, v_created_datetime, 'AutoGen');
            SET v_sched_id = LAST_INSERT_ID();

            -- B. Insert Invoice
            INSERT INTO invoices
            (patient_id, status, subtotalAmount, totalDiscount, finalAmount, isApproved, createdDate, createdBy)
            VALUES
            (v_pat_id, 'PAID', v_amount, 0, v_amount, 1, v_created_datetime, 'AutoGen');
            SET v_inv_id = LAST_INSERT_ID();

            -- C. Insert Invoice Item
            INSERT INTO invoice_items
            (invoice_id, item_type_id, description, amount, isApproved, createdDate, createdBy)
            VALUES
            (v_inv_id, 1, CONCAT('Consultation Fee - Dr ', v_doc_id), v_amount, 1, v_created_datetime, 'AutoGen');

            -- D. Insert Payment
            INSERT INTO payments
            (invoice_id, amountPaid, paymentMethod, paymentStatus, isApproved, createdDate, createdBy)
            VALUES
            (v_inv_id, v_amount, 'CASH', 'COMPLETED', 1, v_created_datetime, 'AutoGen');

            -- E. Insert Appointment
            INSERT INTO appointments
            (queuePosition, status, doctor_schedule_id, patient_id, invoice_id, isApproved, createdDate, createdBy)
            VALUES
            (1, 'COMPLETED', v_sched_id, v_pat_id, v_inv_id, 1, v_created_datetime, 'AutoGen');

            SET i = i + 1;
        END WHILE;
        SET m = m + 1;
    END WHILE;
END $$

DELIMITER ;

-- 3. RUN the procedure
CALL GenerateData2025();

-- 4. CLEANUP
DROP PROCEDURE GenerateData2025;