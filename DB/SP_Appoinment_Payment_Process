DELIMITER $$

DROP PROCEDURE IF EXISTS sp_AppointmentPaymentProcess$$

CREATE PROCEDURE sp_AppointmentPaymentProcess(
    IN p_clinic_id INT,
    IN p_invoice_id INT,
    IN p_amount_paid DECIMAL(10,2),
    IN p_payment_method VARCHAR(50),
    IN p_transaction_code VARCHAR(255),
    IN p_created_by VARCHAR(50),
    IN p_received_by VARCHAR(50),
    IN p_received_by_staff_id INT,
    IN p_payment_location VARCHAR(50),
    IN p_payment_gateway VARCHAR(50),
    IN p_discounts_json JSON,
    OUT o_new_payment_id INT,
    OUT o_remaining_balance DECIMAL(10,2),
    OUT o_status_message VARCHAR(255)
)
proc_label: BEGIN

    -- == 1. DECLARE VARIABLES ==
    DECLARE v_subtotal_amount DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_final_amount DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_current_amount_paid DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_current_balance DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_appointment_id INT;
    DECLARE v_invoice_status_code VARCHAR(30);

    -- Discount Variables
    DECLARE v_existing_discount DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_new_discount_part DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_total_discount DECIMAL(10, 2) DEFAULT 0;

    DECLARE v_new_amount_paid DECIMAL(10, 2);
    DECLARE v_new_balance DECIMAL(10, 2);
    DECLARE v_new_status_code VARCHAR(30);
    DECLARE v_allow_partial_payment TINYINT DEFAULT 1;
    DECLARE v_min_payment_amount DECIMAL(10, 2) DEFAULT 0;
    DECLARE v_now DATETIME;

    -- Variables to hold IDs
    DECLARE v_method_id INT;
    DECLARE v_location_id INT;

    -- == 2. ERROR HANDLING ==
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        GET DIAGNOSTICS CONDITION 1 @sqlstate = RETURNED_SQLSTATE, @errno = MYSQL_ERRNO, @text = MESSAGE_TEXT;
        ROLLBACK;
        SET o_status_message = CONCAT('SQL ERROR ', @errno, ': ', @text);
    END;

    -- == 3. INPUT VALIDATION ==
    SELECT id INTO v_method_id FROM payment_method_lookup WHERE TRIM(code) = TRIM(p_payment_method) LIMIT 1;
    IF v_method_id IS NULL THEN
        SET o_status_message = CONCAT('ERROR_INVALID_PAYMENT_METHOD: ', p_payment_method);
        LEAVE proc_label;
    END IF;

    SELECT id INTO v_location_id FROM payment_location_lookup WHERE TRIM(code) = TRIM(p_payment_location) LIMIT 1;
    IF v_location_id IS NULL THEN
        SET o_status_message = CONCAT('ERROR_INVALID_LOCATION: ', p_payment_location);
        LEAVE proc_label;
    END IF;

    -- == 4. START TRANSACTION ==
    SET v_now = NOW();
    START TRANSACTION;

    -- == 5. GET CONFIGURATION ==
    SELECT
        CASE
            WHEN configValue = 'true' THEN 1
            WHEN configValue = '1' THEN 1
            ELSE 0
        END INTO v_allow_partial_payment
    FROM systemConfig
    WHERE clinic_id = p_clinic_id AND configKey = 'ALLOW_PARTIAL_PAYMENT' LIMIT 1;

    SELECT CAST(configValue AS DECIMAL(10,2)) INTO v_min_payment_amount
    FROM systemConfig WHERE clinic_id = p_clinic_id AND configKey = 'MIN_PARTIAL_PAYMENT_AMOUNT' LIMIT 1;

    SET v_allow_partial_payment = COALESCE(v_allow_partial_payment, 1);
    SET v_min_payment_amount = COALESCE(v_min_payment_amount, 0);

    -- == 6. LOCK INVOICE & GET DATA ==
    SELECT
        i.subtotalAmount, i.finalAmount, i.amountPaid, i.balanceRemaining,
        COALESCE(i.totalDiscount, 0), s.code
    INTO
        v_subtotal_amount, v_final_amount, v_current_amount_paid, v_current_balance,
        v_existing_discount, v_invoice_status_code
    FROM invoices i
    LEFT JOIN invoice_status_lookup s ON i.statusId = s.id
    WHERE i.id = p_invoice_id AND i.clinic_id = p_clinic_id
    FOR UPDATE;

    IF v_invoice_status_code IS NULL THEN SET v_invoice_status_code = 'UNPAID'; END IF;

    SELECT id INTO v_appointment_id FROM appointments
    WHERE invoice_id = p_invoice_id AND clinic_id = p_clinic_id LIMIT 1;

    -- == 7. BUSINESS LOGIC CHECKS ==
    IF v_subtotal_amount IS NULL THEN
        SET o_status_message = 'ERROR_INVALID_INVOICE';
        ROLLBACK; LEAVE proc_label;
    ELSEIF v_invoice_status_code IN ('PAID', 'CANCELLED') THEN
        SET o_status_message = 'ERROR_INVOICE_ALREADY_SETTLED';
        ROLLBACK; LEAVE proc_label;
    ELSEIF p_amount_paid <= 0 THEN
        SET o_status_message = 'ERROR_INVALID_AMOUNT';
        ROLLBACK; LEAVE proc_label;
    ELSEIF p_amount_paid < v_min_payment_amount AND v_allow_partial_payment = 1 THEN
        SET o_status_message = 'ERROR_BELOW_MINIMUM_PAYMENT';
        ROLLBACK; LEAVE proc_label;
    END IF;

    -- == 8. PROCESS DISCOUNTS (Cumulative) ==
    SET v_total_discount = v_existing_discount;

    IF p_discounts_json IS NOT NULL AND JSON_LENGTH(p_discounts_json) > 0 THEN
        INSERT INTO invoice_items (clinic_id, invoice_id, item_type_id, description, amount, createdDate, createdBy)
        SELECT
            p_clinic_id, p_invoice_id, it.id, j.description, COALESCE(j.amount, 0) * -1, v_now, p_created_by
        FROM JSON_TABLE(p_discounts_json, '$[*]' COLUMNS (
                discountType VARCHAR(50) PATH '$.discountType',
                amount DECIMAL(10, 2) PATH '$.amount',
                description VARCHAR(255) PATH '$.description'
            )) AS j
        JOIN item_types it ON j.discountType COLLATE utf8mb4_unicode_ci = it.typeName;

        SELECT COALESCE(SUM(amount), 0) INTO v_new_discount_part
        FROM JSON_TABLE(p_discounts_json, '$[*]' COLUMNS (amount DECIMAL(10, 2) PATH '$.amount')) AS j;

        SET v_total_discount = v_existing_discount + v_new_discount_part;
    END IF;

    SET v_final_amount = v_subtotal_amount - v_total_discount;

    -- == 9. CALCULATE BALANCE ==
    SET v_new_amount_paid = v_current_amount_paid + p_amount_paid;
    SET v_new_balance = v_final_amount - v_new_amount_paid;

    IF v_new_balance < 0 THEN SET v_new_balance = 0; END IF;

    -- == 10. DETERMINE STATUS ==
    IF v_new_balance = 0 THEN SET v_new_status_code = 'PAID';
    ELSEIF v_new_amount_paid > 0 THEN SET v_new_status_code = 'PARTIAL';
    ELSE SET v_new_status_code = 'UNPAID';
    END IF;

    -- == 11. INSERT PAYMENT ==
    INSERT INTO payments (
        clinic_id, invoice_id, amountPaid,
        paymentMethodId, paymentStatusId, paymentLocationId,
        receivedBy, cashierWorkstationId,
        paymentGateway, transactionId, paymentTimestamp, createdDate, createdBy
    ) VALUES (
        p_clinic_id, p_invoice_id, p_amount_paid,
        v_method_id,
        (SELECT id FROM payment_status_lookup WHERE code = 'COMPLETED' LIMIT 1),
        v_location_id,
        p_received_by, p_received_by_staff_id,
        p_payment_gateway, p_transaction_code, v_now, v_now, p_created_by
    );

    SET o_new_payment_id = LAST_INSERT_ID();

    -- == 12. LOG AUDIT ==
    INSERT INTO payment_audit_log (
        clinic_id, payment_id, invoice_id, actionType, newStatus, newAmount, reason, actionBy, actionDate
    ) VALUES (
        p_clinic_id, o_new_payment_id, p_invoice_id, 'CREATED', 'COMPLETED', p_amount_paid,
        CONCAT('Payment processed: ', p_payment_method), p_created_by, v_now
    );

    -- == 13. UPDATE INVOICE ==
    UPDATE invoices
    SET
        statusId = (SELECT id FROM invoice_status_lookup WHERE code = v_new_status_code LIMIT 1),
        totalDiscount = v_total_discount,
        finalAmount = v_final_amount,
        amountPaid = v_new_amount_paid,
        balanceRemaining = v_new_balance,
        updatedDate = v_now,
        updatedBy = p_created_by
    WHERE id = p_invoice_id AND clinic_id = p_clinic_id;

    -- == 14. UPDATE APPOINTMENT (UPDATED FOR 'PARTIAL') ==
    IF v_appointment_id IS NOT NULL THEN
        IF v_new_status_code = 'PAID' THEN
            UPDATE appointments
            SET
                statusId = (SELECT id FROM appointment_status_lookup WHERE code = 'BOOKED' LIMIT 1),
                updatedDate = v_now, updatedBy = p_created_by
            WHERE id = v_appointment_id AND clinic_id = p_clinic_id;

        ELSEIF v_new_status_code = 'PARTIAL' THEN
            -- [CHANGE]: Now uses 'PARTIAL' lookup instead of 'PENDING_PAYMENT'
            UPDATE appointments
            SET
                statusId = (SELECT id FROM appointment_status_lookup WHERE code = 'PARTIAL' LIMIT 1),
                note = CONCAT(COALESCE(note, ''), '\n[Partial: ', p_amount_paid, ']'),
                updatedDate = v_now, updatedBy = p_created_by
            WHERE id = v_appointment_id AND clinic_id = p_clinic_id;
        END IF;
    END IF;

    -- == 15. OUTPUT ==
    SET o_remaining_balance = v_new_balance;
    IF v_new_status_code = 'PAID' THEN SET o_status_message = 'PAYMENT_SUCCESS_FULL';
    ELSEIF v_new_status_code = 'PARTIAL' THEN SET o_status_message = 'PAYMENT_SUCCESS_PARTIAL';
    ELSE SET o_status_message = 'PAYMENT_SUCCESS';
    END IF;

    COMMIT;

END$$

DELIMITER ;