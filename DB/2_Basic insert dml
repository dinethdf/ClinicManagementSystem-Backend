INSERT INTO plan_features (subscription_plan_id, feature_id, is_enabled)
SELECT
    (SELECT id FROM subscription_plans WHERE plan_code = 'PLAN_BASIC'),
    f.id,
    TRUE
FROM features f
WHERE f.feature_code IN (
    'FEAT_APPOINTMENTS',
    'FEAT_PATIENT_RECORDS',
    'FEAT_PRESCRIPTION',
    'FEAT_REPORTS_BASIC',
    'FEAT_REPORTS_EXPORT_PDF',
    'FEAT_EMAIL_NOTIFICATIONS',
    'FEAT_SMS_NOTIFICATIONS'
);

