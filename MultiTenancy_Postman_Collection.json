							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_isolated\",\n    \"password\": \"password\",\n    \"loginType\": \"USER\",\n    \"subdomain\": \"isolated-clinic\"\n}",
							"options": {
								"raw": {
									"language": "json"
