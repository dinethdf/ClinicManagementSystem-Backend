	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Shared Mode)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_shared\",\n    \"password\": \"password\",\n    \"loginType\": \"USER\",\n    \"clinicId\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/signIn",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"signIn"
							]
						}
					},
					"response": []
				},
				{
