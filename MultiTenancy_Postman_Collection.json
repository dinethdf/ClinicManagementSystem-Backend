		{
			"name": "3. Tenant Data (Authenticated)",
			"item": [
				{
					"name": "Get Clinic Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/clinic/info/details",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"clinic",
								"info",
								"details"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Public Routing (No Auth)",
			"item": [
				{
					"name": "Check Patient (via Header)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Tenant-Code",
								"value": "YOUR_CLINIC_CODE_HERE",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/public/check-patient?query=0771234567&clinicId=1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"public",
								"check-patient"
							],
							"query": [
								{
									"key": "query",
									"value": "0771234567"
								},
								{
									"key": "clinicId",
									"value": "1"
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "your_jwt_here",
			"type": "string"
		}
	]
