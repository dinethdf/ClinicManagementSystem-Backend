						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"clinicName\": \"Test Dynamic Clinic\",\n    \"subdomain\": \"dynamic-test\",\n    \"mobileNo1\": \"0770000000\",\n    \"address\": \"Test Address\",\n    \"city\": \"Colombo\"\n}",
							"options": {
