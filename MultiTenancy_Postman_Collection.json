				{
					"name": "Private Clinic Registration (Super Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Isolated Health Center\",\n    \"subdomain\": \"isolated-health\",\n    \"planCode\": \"PLAN_PRO\",\n    \"tenantMode\": \"SCHEMA\"\n}",
