{
	"info": {
		"_postman_id": "8a3b2c1d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
		"name": "CureGuard Multi-Tenancy Tests",
		"description": "Collection to test Hybrid Multi-Tenancy (Shared vs Schema isolation)",
